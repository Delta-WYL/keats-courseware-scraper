{
  "name": "keats-courseware-scraper",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: automatically scrape KCL KEATS (Moodle) courseware into a brand-new local folder via a fixed command or /keats.",
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "plugin", "keats", "moodle", "scraper", "courseware"],
  "type": "module",
  "engines": { "node": ">=18" },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "scraper.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
